# ===========================================================================
# VastaFlow - configuracao do backup (MODELO). Copie para /etc/vastaflow/backup.env na VPS
# (dono root, modo 600). NUNCA versione o arquivo preenchido.
# ===========================================================================

# Impressao digital da chave gpg PUBLICA que cifra os backups. Gere o par de chaves no SEU computador (ou
# num cofre), importe SO a publica na VPS (`gpg --import publica.asc`) e guarde a privada FORA da VPS.
# Sem a privada nao ha restauracao: faca copia dela em dois lugares seguros. Ver docs/backup-restauracao.md.
BACKUP_GPG_RECIPIENT=

# Onde ficam os backups LOCAIS na VPS (disco da propria VPS: protege de erro humano, NAO de perder a VPS).
BACKUP_DIR=/var/backups/vastaflow

# Retencao local: apaga com mais de N dias, mas sempre preserva os BACKUP_KEEP_MIN mais recentes.
BACKUP_RETENTION_DAYS=14
BACKUP_KEEP_MIN=3

# DESTINO EXTERNO (obrigatorio antes do go-live). Formato rclone "remoto:pasta". Provisorio decidido: Google Drive.
#   BACKUP_REMOTE=gdrive:vastaflow-backups     (ver docs/backup-google-drive.md; infra/backup/rclone.conf.example)
# Vazio = so copia local (o script avisa e o vigia alerta). As credenciais do destino ficam na configuracao do rclone
# da VPS (~/.config/rclone/rclone.conf, modo 600), nunca neste arquivo e nunca no Git.
BACKUP_REMOTE=
# Orcamento de bytes que ESTES backups podem ocupar no destino (padrao 8 GiB; o Drive gratis tem 15 GB COMPARTILHADOS
# com Gmail e Fotos). Passou disso, os mais antigos sao removidos (preservando BACKUP_KEEP_MIN) e sai um aviso.
BACKUP_REMOTE_MAX_BYTES=8589934592
# Folga minima que precisa sobrar livre no destino depois do envio (padrao 1 GiB). Sem ela o envio e recusado e alerta.
BACKUP_REMOTE_MIN_FREE_BYTES=1073741824
# Retencao no destino: o mais recente de cada um dos ultimos 7 dias, 4 semanas e 3 meses.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=3
# Espaco livre minimo no disco da VPS e limite de tamanho para o aviso "backup grande".
BACKUP_LOCAL_MIN_FREE_BYTES=2147483648
BACKUP_ALERT_SIZE_BYTES=524288000
# Vigia diario: horas sem backup novo (local e no destino) antes de alertar.
BACKUP_MAX_AGE_HOURS=30

# ALERTAS (pelo menos um canal e obrigatorio em producao - sem alerta, falha de backup passa despercebida).
# Telegram: crie um bot SO para alertas no BotFather (nao reutilize o do VastaFlow) e coloque aqui o token e o seu chat id.
BACKUP_ALERT_TELEGRAM_BOT_TOKEN=
BACKUP_ALERT_TELEGRAM_CHAT_ID=
# Opcional: monitor externo de "heartbeat" (estilo healthchecks.io). Avisa tambem quando o backup NAO roda.
BACKUP_HEARTBEAT_URL=
