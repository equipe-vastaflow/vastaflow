# Instalar em /etc/systemd/system/ (ajuste WorkingDirectory/ExecStart para onde o repositorio estiver na VPS).
[Unit]
Description=VastaFlow - backup cifrado (MySQL, PostgreSQL do n8n, documentos, configuracao) e copia externa
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
# Qualquer falha (dump, disco, destino externo) aciona o alerta. O proprio script ja alerta com detalhe nos casos
# conhecidos; o alerta abaixo e um "rede de seguranca" que nao duplica (--se-nao-recente).
OnFailure=vastaflow-backup-alert.service

[Service]
Type=oneshot
WorkingDirectory=/opt/vastaflow
ExecStart=/bin/bash /opt/vastaflow/scripts/backup.sh
Nice=10
IOSchedulingClass=idle
# O backup cria arquivos 0600/0700 por conta propria (umask 077).
