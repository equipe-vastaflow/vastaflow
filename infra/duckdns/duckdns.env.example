# ===========================================================================
# VastaFlow - DuckDNS (MODELO). Copie para /etc/vastaflow/duckdns.env na VPS (root, modo 600).
# NUNCA versione o arquivo preenchido. Este projeto NAO cria conta nem registra subdominio: voce faz isso em
# duckdns.org (login por conta existente) e copia o token para ESTE arquivo, direto na VPS - nunca no chat.
# ===========================================================================
# So o subdominio. Para vastaflow.duckdns.org, escreva: vastaflow
DUCKDNS_DOMAIN=
# Token da sua conta DuckDNS (aparece na pagina da conta). SEGREDO.
DUCKDNS_TOKEN=
# Vazio = o DuckDNS usa o IP de origem (a propria VPS). Preencha so se quiser fixar um IPv4.
DUCKDNS_IP=
