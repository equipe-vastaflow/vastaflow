# Copie para `.env` (Windows: Copy-Item .env.example .env).
# O arquivo `.env` esta no .gitignore. Variaveis VITE_* vao para o bundle
# publico do navegador: NUNCA coloque segredos aqui.
#
# Estas variaveis sao de BUILD, nao de execucao: o Vite substitui o valor no
# bundle gerado. Trocar de ambiente exige um build novo - nao existe
# configuracao em runtime.

# URL base do backend, sem barra no final.
#
# OBRIGATORIA em producao: `vite build` FALHA quando ela esta ausente, para que
# o bundle nunca saia apontando para localhost em silencio. Em desenvolvimento,
# ausente, cai em http://localhost:3000 por conveniencia.
#
# Em producao informe a URL publica da API, por exemplo:
#   VITE_API_URL=https://api.<dominio>
#
# NAO e segredo: e uma URL que o navegador precisa conhecer de qualquer forma.
VITE_API_URL=http://localhost:3000
