# Dependencias
node_modules/
.pnp/
.pnp.js

# Build
dist/
build/
out/
*.tsbuildinfo

# Variaveis de ambiente e segredos
.env
.env.*
!.env.example

# Certificados e chaves (NFS-e, integracoes, assinaturas digitais)
*.pem
*.key
*.pfx
*.p12
*.crt
*.cer
*.jks
certs/
secrets/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testes e cobertura
coverage/
.nyc_output/

# Cache de ferramentas
.cache/
.eslintcache
.parcel-cache/
.vite/

# Editores
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
*.swp
*.swo

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Dados locais de banco / dumps
*.sqlite
*.sqlite3
*.db
dumps/
