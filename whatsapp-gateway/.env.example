# whatsapp-gateway - variaveis (so este servico as le). Valores abaixo sao PLACEHOLDERS.
# Segredo NUNCA no Git, em argumento de linha de comando ou em imagem: use arquivo montado somente leitura.

# Origem do backend (so a origem). https em qualquer host, ou http apenas para a rede interna (host sem ponto).
GATEWAY_BACKEND_URL=http://backend:3000

# Caminho do ARQUIVO com a credencial de servico do principal whatsapp-gateway (gerada pela CLI do backend, sem passar
# o token em argumento). Alternativa so para desenvolvimento local: GATEWAY_SERVICE_TOKEN.
GATEWAY_SERVICE_TOKEN_FILE=/run/secrets/whatsapp-gateway-token

# Numero (so digitos) da conta do bot. Deve ser o mesmo de WHATSAPP_GATEWAY_ACCOUNT no backend. A conta que conectar
# precisa ser esta; qualquer outra faz o gateway parar sem encaminhar nada.
GATEWAY_ACCOUNT=

# Opcionais (padroes seguros): timeouts em ms, limite global de respostas por minuto e tamanho maximo da fila.
# GATEWAY_INGEST_TIMEOUT_MS=10000
# GATEWAY_SEND_TIMEOUT_MS=15000
# GATEWAY_MAX_REPLIES_PER_MINUTE=20
# GATEWAY_MAX_QUEUE=100
