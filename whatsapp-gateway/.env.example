# whatsapp-gateway - variaveis (so este servico as le). Valores abaixo sao PLACEHOLDERS.
# SEGREDO NUNCA no Git, em argumento de linha de comando, em imagem ou em log: use ARQUIVO montado somente leitura
# (`..._FILE`). A variavel sem `_FILE` existe so para desenvolvimento local.

# ---- backend ----
# Origem do backend (so a origem). https em qualquer host, ou http apenas para a rede interna (host sem ponto).
GATEWAY_BACKEND_URL=http://backend:3000
# Credencial de servico do principal whatsapp-gateway (gerada pela CLI do backend, sem passar o token em argumento).
GATEWAY_SERVICE_TOKEN_FILE=/run/secrets/whatsapp-gateway-token
# Numero (so digitos) da conta do bot; igual a WHATSAPP_GATEWAY_ACCOUNT no backend. Conta diferente = o gateway para.
GATEWAY_ACCOUNT=

# ---- sessao do WhatsApp (cifrada, em tabela propria do MySQL) ----
# Identificador da sessao (letras minusculas, digitos, hifen). Padrao: principal.
# GATEWAY_SESSION_ID=principal
GATEWAY_DB_HOST=mysql
# GATEWAY_DB_PORT=3306
GATEWAY_DB_NAME=
# Usuario com permissao SO em whatsapp_auth_state e whatsapp_auth_lock (ver docs/whatsapp-gateway.md, secao 7.7).
GATEWAY_DB_USER=whatsapp_gateway
GATEWAY_DB_PASSWORD_FILE=/run/secrets/whatsapp-gateway-db-password
# CHAVE DE CIFRA da sessao: 32 bytes ALEATORIOS em base64 (openssl rand -base64 32) ou 64 hex. SEM valor padrao.
# Exclusiva do gateway; guarde-a fora do banco. Chave errada = o gateway se recusa a abrir (nunca recria a sessao).
GATEWAY_AUTH_ENCRYPTION_KEY_FILE=/run/secrets/whatsapp-gateway-auth-key

# ---- conexao com o WhatsApp ----
# Padrao false: o processo so VERIFICA (configuracao, chave, banco, trava) e sai, sem abrir socket. So 'true' liga.
# Nao ligar antes do pareamento e do teste autorizados (etapas seguintes).
# GATEWAY_CONNECT_ENABLED=false

# Opcionais (padroes seguros): timeouts em ms, limite global de respostas por minuto e tamanho maximo da fila.
# GATEWAY_INGEST_TIMEOUT_MS=10000
# GATEWAY_SEND_TIMEOUT_MS=15000
# GATEWAY_MAX_REPLIES_PER_MINUTE=20
# GATEWAY_MAX_QUEUE=100
