# Versoes sempre EXATAS (nada de ^ ou ~) e sem scripts de instalacao: nenhum pacote executa codigo no `npm install`.
save-exact=true
ignore-scripts=true
# O Baileys declara `sharp` como peer NAO opcional (so serve para miniaturas de midia, que o gateway nunca usa).
# Sem isto o npm instalaria um binario nativo sem necessidade; o gateway so trata texto.
legacy-peer-deps=true
fund=false
audit=true
