# ===========================================================================
# VastaFlow - modelo de variaveis de ambiente
# ---------------------------------------------------------------------------
# Copie este arquivo para `.env` e preencha os valores do SEU ambiente.
#
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux / macOS:         cp .env.example .env
#
# O arquivo `.env` esta no .gitignore e NUNCA deve ser versionado.
# Nao preencha valores reais neste arquivo de exemplo.
#
# O backend le `backend/.env`; o docker-compose le o `.env` da raiz. Mantenha
# os dois com os mesmos valores de banco:
#   Windows (PowerShell):  Copy-Item .env backend\.env
#   Linux / macOS:         cp .env backend/.env
# ===========================================================================

# ---------------------------------------------------------------------------
# Aplicacao
# ---------------------------------------------------------------------------
# Ambiente de execucao: development | production | test
NODE_ENV=development

# Porta HTTP do backend
PORT=3000

# Identificador do servico, devolvido por GET /health
APP_NAME=vasta-flow

# Expor a documentacao Swagger em /docs.
# Padrao `false`: a documentacao descreve toda a superficie da API, entao e
# opt-in explicito. A aplicacao RECUSA iniciar com `true` em producao.
SWAGGER_ENABLED=true

# Origens autorizadas a chamar a API pelo navegador (CORS), separadas por
# virgula. Vazio = CORS desligado. Em desenvolvimento e a URL do Vite.
# Em producao e a origem do frontend publicado (esquema + host, sem caminho).
FRONTEND_ORIGIN=http://localhost:5173


# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# O frontend tem o PROPRIO arquivo de ambiente: frontend/.env (modelo em
# frontend/.env.example). Ele nao le este arquivo.
#
# A unica variavel e VITE_API_URL, e ela e de BUILD, nao de execucao: o Vite
# substitui o valor no bundle. Consequencias:
#   - e PUBLICA (vai para o bundle do navegador). Nada sensivel pode ser VITE_*;
#   - cada ambiente exige o proprio build;
#   - em producao ela e OBRIGATORIA: `vite build` falha sem ela, para que o
#     bundle nunca saia apontando para localhost em silencio.


# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
# Define qual driver sera usado pela camada de persistencia: mysql | oracle
DATABASE_TYPE=mysql

# Sem DATABASE_URL, HOST/NAME/USER/PASSWORD sao obrigatorios.
DATABASE_HOST=127.0.0.1
# Padrao por driver quando vazio: 3306 (MySQL) | 1521 (Oracle)
DATABASE_PORT=3306
DATABASE_NAME=vastaflow
DATABASE_USER=vastaflow
# Escolha uma senha para o SEU ambiente local
DATABASE_PASSWORD=

# ---------------------------------------------------------------------------
# TLS do MySQL
# ---------------------------------------------------------------------------
# Exige TLS na conexao com o MySQL. Sao DUAS garantias, as duas sempre ligadas
# e nenhuma configuravel:
#   1. a CADEIA do certificado e validada (rejectUnauthorized);
#   2. a IDENTIDADE do servidor e validada (verifyIdentity) - o certificado
#      precisa ter sido emitido para o host informado em DATABASE_HOST.
# Padrao `false`, porque o MySQL local normalmente nao tem TLS. A aplicacao
# RECUSA iniciar em producao com MySQL e este valor em `false`.
DATABASE_SSL=false

# CA que assina o certificado do servidor, em PEM (o CONTEUDO, nao um caminho).
# OBRIGATORIA quando DATABASE_SSL=true. Sem ela a aplicacao recusa iniciar:
# nao existe mais fallback para a CA de banco gerenciado da AWS, que assinaria
# certificados de instancias alheias.
# NUNCA versione um certificado nem uma chave: preencha apenas no ambiente.
# O certificado em si nao e segredo; a chave privada dele e, e nunca passa aqui.
DATABASE_SSL_CA=

# ATENCAO ao host quando TLS esta ligado em producao: DATABASE_HOST precisa ser
# um NOME, nunca um endereco IP, e esse nome tem de constar no SAN do
# certificado do servidor. Com IP o driver nao envia `servername` e a validacao
# de identidade seria saltada em silencio - a aplicacao recusa iniciar nesse
# caso. Na topologia prevista o nome e o do servico no Docker Compose.

# Fluxo padrao: `false` + `npm run migration:run` (em backend/).
# `true` cria/altera as tabelas direto das entities ao subir, ignorando as
# migrations - so para prototipo local e descartavel. A aplicacao recusa iniciar
# com `true` em producao. Nao misture: um banco criado por synchronize nao
# aceita as migrations depois (as tabelas ja existiriam).
DATABASE_SYNCHRONIZE=false

# URL de conexao completa. Opcional: quando preenchida, tem precedencia
# sobre as variaveis HOST/PORT/NAME/USER/PASSWORD acima.
DATABASE_URL=

# Exclusivo Oracle - preencha APENAS UM dos dois, conforme o que o DBA expor.
# Consulte docs/adr/0001-escolha-do-orm-e-estrategia-de-banco.md
DATABASE_ORACLE_SID=
DATABASE_ORACLE_SERVICE_NAME=

# Senha do usuario root do MySQL usado pelo docker-compose (desenvolvimento local)
DATABASE_ROOT_PASSWORD=


# ---------------------------------------------------------------------------
# Autenticacao
# ---------------------------------------------------------------------------
# OBRIGATORIO. Segredo de assinatura do JWT, com no minimo 32 caracteres.
# Gere um valor aleatorio e longo por ambiente. Sugestao:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Tempo de validade do token de acesso, no formato 30s, 15m, 1h, 7d
JWT_EXPIRES_IN=1h

# Custo do hash bcrypt (4 a 15; 10 a 12 e o intervalo usual)
BCRYPT_SALT_ROUNDS=12

# Administrador inicial, criado no boot se ainda nao existir. Informe os dois
# juntos. E a UNICA forma de obter o primeiro ADMIN: o cadastro publico
# (POST /auth/register) so cria usuarios comuns. A senha precisa ter 8 a 72
# caracteres, com maiuscula, minuscula e numero. Apague-a do .env depois do
# primeiro boot, se preferir - o usuario ja fica salvo no banco.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrador


# ---------------------------------------------------------------------------
# n8n - futuro  (nada a definir nesta fase)
# ---------------------------------------------------------------------------
# O n8n sera auto-hospedado em container proprio, com PostgreSQL proprio, e
# tera o PROPRIO conjunto de variaveis - elas pertencem ao compose do n8n, nao
# a este arquivo, e por isso NAO estao listadas aqui. Ver
# docs/adr/0003-topologia-de-producao.md.
#
# Duas ficam registradas agora porque tem consequencia de recuperacao:
#   - a chave de criptografia do n8n precisa ser definida explicitamente e
#     guardada FORA da VPS: sem ela, nem um backup intacto do banco recupera as
#     credenciais das integracoes;
#   - a credencial de servico que o n8n usara para chamar esta API ainda NAO
#     existe. O contrato esta em docs/autenticacao-servico-a-servico.md e a
#     implementacao e de fase posterior.


# ---------------------------------------------------------------------------
# Mensageria e integracoes externas - futuro  (sem implementacao)
# ---------------------------------------------------------------------------
# As chaves abaixo sao apenas reserva de NOME. Nenhuma destas integracoes foi
# implementada e nenhum endpoint foi definido: elas so serao preenchidas quando
# tivermos a documentacao e o acesso oficiais de cada provedor.
#
# WHATSAPP_*   - pendente de validacao oficial da plataforma Meta.
#                Nenhum numero de telefone entra neste arquivo nem no
#                repositorio: numero de cliente e dado operacional, definido
#                somente no ambiente do servidor.
# PLANTAE_*    - bloqueado por dependencia externa: documentacao e API Key
#                serao fornecidas pelo TI do Plantae.
# NFSE_*       - fase posterior. Exigira certificado digital ICP-Brasil, que
#                NUNCA fica no repositorio nem no cofre do n8n.
# EMAIL_*      - pendente de definicao do servidor SMTP.

# ---------------------------------------------------------------------------
# Documentos
# ---------------------------------------------------------------------------
# Onde o storage LOCAL grava os bytes dos documentos. Relativo ao diretorio de
# trabalho do processo quando nao for absoluto.
# Vale somente para o adapter de filesystem; o storage em S3 tera a propria
# configuracao quando existir.
DOCUMENT_STORAGE_PATH=./storage/documents

# Tamanho maximo de UM documento, em bytes. Padrao: 10485760 (10 MB).
# ATENCAO: valor inicial conservador, NAO aprovado pelo negocio - revisar com a
# Vasta antes do uso real. Teto permitido: 104857600 (100 MB).
# Nao confundir com o limite global de corpo das rotas JSON (100 kB), que
# continua valendo e e proposital.
DOCUMENT_MAX_FILE_SIZE=10485760


# ---------------------------------------------------------------------------
# Integracao: Telegram (Bot API oficial)
# ---------------------------------------------------------------------------
# Token do bot, emitido pelo @BotFather. SEGREDO: nunca versionar o valor.
# Vazio = integracao NOT_CONFIGURED; a aplicacao sobe normalmente.
TELEGRAM_BOT_TOKEN=
# Recebe mensagens por long polling (getUpdates). Opt-in: o token sozinho nao
# liga o polling. Ligue em UM unico ambiente por bot - o Telegram recusa dois
# getUpdates simultaneos para o mesmo bot.
TELEGRAM_POLLING_ENABLED=false
