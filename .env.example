# ===========================================================================
# VastaFlow - modelo de variaveis de ambiente
# ---------------------------------------------------------------------------
# Copie este arquivo para `.env` e preencha os valores do SEU ambiente.
#
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux / macOS:         cp .env.example .env
#
# O arquivo `.env` esta no .gitignore e NUNCA deve ser versionado.
# Nao preencha valores reais neste arquivo de exemplo.
#
# O backend le `backend/.env`; o docker-compose le o `.env` da raiz. Mantenha
# os dois com os mesmos valores de banco:
#   Windows (PowerShell):  Copy-Item .env backend\.env
#   Linux / macOS:         cp .env backend/.env
# ===========================================================================

# ---------------------------------------------------------------------------
# Aplicacao
# ---------------------------------------------------------------------------
# Ambiente de execucao: development | production | test
NODE_ENV=development

# Porta HTTP do backend
PORT=3000

# Identificador do servico, devolvido por GET /health
APP_NAME=vasta-flow

# Expor a documentacao Swagger em /docs.
# Padrao `false`: a documentacao descreve toda a superficie da API, entao e
# opt-in explicito. A aplicacao RECUSA iniciar com `true` em producao.
SWAGGER_ENABLED=true

# Origens autorizadas a chamar a API pelo navegador (CORS), separadas por
# virgula. Vazio = CORS desligado. Em desenvolvimento e a URL do Vite.
# Em producao e a origem do frontend publicado (esquema + host, sem caminho).
FRONTEND_ORIGIN=http://localhost:5173


# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# O frontend tem o PROPRIO arquivo de ambiente: frontend/.env (modelo em
# frontend/.env.example). Ele nao le este arquivo.
#
# A unica variavel e VITE_API_URL, e ela e de BUILD, nao de execucao: o Vite
# substitui o valor no bundle. Consequencias:
#   - e PUBLICA (vai para o bundle do navegador). Nada sensivel pode ser VITE_*;
#   - cada ambiente exige o proprio build;
#   - em producao ela e OBRIGATORIA: `vite build` falha sem ela, para que o
#     bundle nunca saia apontando para localhost em silencio.


# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
# Define qual driver sera usado pela camada de persistencia: mysql | oracle
DATABASE_TYPE=mysql

# Sem DATABASE_URL, HOST/NAME/USER/PASSWORD sao obrigatorios.
DATABASE_HOST=127.0.0.1
# Padrao por driver quando vazio: 3306 (MySQL) | 1521 (Oracle)
DATABASE_PORT=3306
DATABASE_NAME=vastaflow
DATABASE_USER=vastaflow
# Escolha uma senha para o SEU ambiente local
DATABASE_PASSWORD=

# ---------------------------------------------------------------------------
# TLS do MySQL
# ---------------------------------------------------------------------------
# Exige TLS na conexao com o MySQL. Sao DUAS garantias, as duas sempre ligadas
# e nenhuma configuravel:
#   1. a CADEIA do certificado e validada (rejectUnauthorized);
#   2. a IDENTIDADE do servidor e validada (verifyIdentity) - o certificado
#      precisa ter sido emitido para o host informado em DATABASE_HOST.
# Padrao `false`, porque o MySQL local normalmente nao tem TLS. A aplicacao
# RECUSA iniciar em producao com MySQL e este valor em `false`.
DATABASE_SSL=false

# A CA que assina o certificado do servidor MySQL. Duas formas, e EXATAMENTE
# UMA por vez - nao existe precedencia, e informar as duas e recusado no boot.
#
# Forma 1: o CONTEUDO PEM, inline. Serve para gerenciadores de segredo que
# entregam valor. Em arquivo .env um PEM multilinha e incomodo.
DATABASE_SSL_CA=

# Forma 2: o CAMINHO de um arquivo PEM montado. E a forma adequada a container -
# monte o arquivo somente-leitura e aponte para ele. `*_FILE` e a convencao que
# as proprias imagens oficiais de banco usam.
#   Exemplo: DATABASE_SSL_CA_FILE=/etc/vastaflow/tls/ca.pem
DATABASE_SSL_CA_FILE=

# OBRIGATORIA (uma das duas) quando DATABASE_SSL=true em producao. Sem ela a
# aplicacao recusa iniciar: nao existe mais fallback para a CA de banco
# gerenciado da AWS, que assinaria certificados de instancias alheias.
#
# NUNCA versione certificado nem chave: configure apenas no ambiente.
# O certificado da CA nao e segredo; a CHAVE PRIVADA dela e, e nunca passa por
# nenhuma destas variaveis nem chega ao backend.

# ATENCAO ao host quando TLS esta ligado em producao: DATABASE_HOST precisa ser
# um NOME, nunca um endereco IP, e esse nome tem de constar no SAN do
# certificado do servidor. Com IP o driver nao envia `servername` e a validacao
# de identidade seria saltada em silencio - a aplicacao recusa iniciar nesse
# caso. Na topologia prevista o nome e o do servico no Docker Compose.

# Fluxo padrao: `false` + `npm run migration:run` (em backend/).
# `true` cria/altera as tabelas direto das entities ao subir, ignorando as
# migrations - so para prototipo local e descartavel. A aplicacao recusa iniciar
# com `true` em producao. Nao misture: um banco criado por synchronize nao
# aceita as migrations depois (as tabelas ja existiriam).
DATABASE_SYNCHRONIZE=false

# URL de conexao completa. Opcional: quando preenchida, tem precedencia
# sobre as variaveis HOST/PORT/NAME/USER/PASSWORD acima.
DATABASE_URL=

# Exclusivo Oracle - preencha APENAS UM dos dois, conforme o que o DBA expor.
# Consulte docs/adr/0001-escolha-do-orm-e-estrategia-de-banco.md
DATABASE_ORACLE_SID=
DATABASE_ORACLE_SERVICE_NAME=

# Senha do usuario root do MySQL usado pelo docker-compose (desenvolvimento local)
DATABASE_ROOT_PASSWORD=


# ---------------------------------------------------------------------------
# Autenticacao
# ---------------------------------------------------------------------------
# OBRIGATORIO. Segredo de assinatura do JWT, com no minimo 32 caracteres.
# Gere um valor aleatorio e longo por ambiente. Sugestao:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Tempo de validade do token de acesso, no formato 30s, 15m, 1h, 7d
JWT_EXPIRES_IN=1h

# Custo do hash bcrypt (4 a 15; 10 a 12 e o intervalo usual)
BCRYPT_SALT_ROUNDS=12

# Administrador inicial, criado no boot se ainda nao existir. Informe os dois
# juntos. E a UNICA forma de obter o primeiro ADMIN: o cadastro publico
# (POST /auth/register) so cria usuarios comuns. A senha precisa ter 8 a 72
# caracteres, com maiuscula, minuscula e numero. Apague-a do .env depois do
# primeiro boot, se preferir - o usuario ja fica salvo no banco.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrador


# ---------------------------------------------------------------------------
# PostgreSQL do n8n  (Fase 3 - so o docker-compose le; o backend NAO)
# ---------------------------------------------------------------------------
# Banco DEDICADO ao n8n. O negocio do VastaFlow fica no MySQL; aqui so mora o
# estado interno do n8n (workflows, execucoes, credenciais CIFRADAS).
# Sem porta publicada e sem rota ao MySQL.
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
# Obrigatoria. Gere uma propria (ex.: openssl rand -base64 24).
N8N_DB_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE_E_UNICA

# ---------------------------------------------------------------------------
# n8n  (Fase 3 - so o docker-compose le; o backend NAO)
# ---------------------------------------------------------------------------
# Chave que CIFRA as credenciais guardadas no banco do n8n. Obrigatoria e
# explicita. Gere uma propria (ex.: openssl rand -hex 32).
#
# ATENCAO: perder esta chave torna ILEGIVEIS todas as credenciais do n8n, mesmo
# com o backup do banco intacto. Guarde uma copia FORA da VPS (cofre de
# senhas), SEPARADA dos backups do volume e do banco. Trocar a chave exige
# migrar as credenciais - nao e so editar este valor.
N8N_ENCRYPTION_KEY=TROQUE_POR_64_CARACTERES_HEXADECIMAIS_ALEATORIOS
# Porta do editor, publicada SOMENTE em 127.0.0.1 do host (nunca 0.0.0.0).
N8N_EDITOR_PORT=5678
GENERIC_TIMEZONE=America/Sao_Paulo
# Cookie `Secure` do editor. Deixe `true`; so mude em um ambiente local que
# comprovadamente nao o aceite.
N8N_SECURE_COOKIE=true

# ---------------------------------------------------------------------------
# Autenticacao de SERVICO  (n8n -> backend)
# ---------------------------------------------------------------------------
# NAO ha segredo neste arquivo para isto. O backend le HASHES de um arquivo
# (infra/service-auth/credentials.json, fora do Git); o token em si so existe
# no cofre de credenciais do n8n. Criar, rotacionar e revogar:
# docs/autenticacao-servico-a-servico.md.
#
# No compose a variavel ja vem definida (caminho DENTRO do container). Fora do
# compose (backend rodando direto), aponte para o arquivo; sem ela o recurso
# fica DESLIGADO e toda rota de servico responde 401.
# SERVICE_CREDENTIALS_FILE=./infra/service-auth/credentials.json


# ---------------------------------------------------------------------------
# Plantae  (Fase 4 - API externa, SOMENTE leitura, SOMENTE homologacao)
# ---------------------------------------------------------------------------
# Integracao com a API externa do Plantae: oito consultas GET, para ADMIN humano.
# DESLIGADA por padrao. Ver docs/integracao-plantae.md.
#
# Quem le: o BACKEND (e o compose, que repassa so ao backend). NUNCA o n8n, o
# frontend ou o `migrate`.
PLANTAE_ENABLED=false
# So o host de HOMOLOGACAO e aceito (em HTTPS, neste caminho exato). Qualquer outro
# valor derruba o boot. Uma URL de producao so entra depois da liberacao oficial
# da Plantae, por mudanca de codigo.
PLANTAE_BASE_URL=https://rc.plantae.agr.br/api/v1/external
# Chave de integracao entregue pela Plantae. SEGREDO: nunca no Git, nunca colar em
# chat ou ticket. Sem ela, a integracao fica NOT_CONFIGURED (nada quebra). Se a
# chave vazou, a Plantae a revoga e emite outra.
PLANTAE_API_TOKEN=
# Timeout de UMA requisicao, em ms (1000 a 60000). Padrao: 15000.
# PLANTAE_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Mensageria e integracoes externas - futuro  (sem implementacao)
# ---------------------------------------------------------------------------
# As chaves abaixo sao apenas reserva de NOME. Nenhuma destas integracoes foi
# implementada e nenhum endpoint foi definido: elas so serao preenchidas quando
# tivermos a documentacao e o acesso oficiais de cada provedor.
#
# WHATSAPP_*   - pendente de validacao oficial da plataforma Meta.
#                Nenhum numero de telefone entra neste arquivo nem no
#                repositorio: numero de cliente e dado operacional, definido
#                somente no ambiente do servidor.
# PLANTAE_*    - JA IMPLEMENTADO (so leitura, so homologacao): ver a secao
#                "Plantae" acima. A chave de PRODUCAO e o endereco de producao
#                ainda dependem da liberacao oficial da Plantae.
# NFSE_*       - fase posterior. Exigira certificado digital ICP-Brasil, que
#                NUNCA fica no repositorio nem no cofre do n8n.
# EMAIL_*      - pendente de definicao do servidor SMTP.

# ---------------------------------------------------------------------------
# Documentos
# ---------------------------------------------------------------------------
# Onde o storage LOCAL grava os bytes dos documentos. Relativo ao diretorio de
# trabalho do processo quando nao for absoluto.
# Vale somente para o adapter de filesystem; o storage em S3 tera a propria
# configuracao quando existir.
DOCUMENT_STORAGE_PATH=./storage/documents

# Tamanho maximo de UM documento, em bytes. Padrao: 10485760 (10 MB).
# ATENCAO: valor inicial conservador, NAO aprovado pelo negocio - revisar com a
# Vasta antes do uso real. Teto permitido: 104857600 (100 MB).
# Nao confundir com o limite global de corpo das rotas JSON (100 kB), que
# continua valendo e e proposital.
DOCUMENT_MAX_FILE_SIZE=10485760


# ---------------------------------------------------------------------------
# Integracao: Telegram (Bot API oficial)
# ---------------------------------------------------------------------------
# Token do bot, emitido pelo @BotFather. SEGREDO: nunca versionar o valor.
# Vazio = integracao NOT_CONFIGURED; a aplicacao sobe normalmente.
TELEGRAM_BOT_TOKEN=
# Recebe mensagens por long polling (getUpdates). Opt-in: o token sozinho nao
# liga o polling. Ligue em UM unico ambiente por bot - o Telegram recusa dois
# getUpdates simultaneos para o mesmo bot.
TELEGRAM_POLLING_ENABLED=false

# ---------------------------------------------------------------------------
# Telegram + n8n  (Fase 5 - fluxo conversacional; DESLIGADO por padrao)
# ---------------------------------------------------------------------------
# Ver docs/telegram-n8n.md e docs/adr/0004-telegram-n8n-envelope-assinado.md.
#
# direct = o backend avalia a mensagem sozinho (padrao, o modo da Fase 2).
# n8n    = o backend assina um envelope, entrega ao workflow do n8n e responde com
#          o que o proprio backend devolveu. Exige as duas variaveis abaixo.
TELEGRAM_DELIVERY_MODE=direct
# Webhook de PRODUCAO do workflow, na rede interna do Compose. So aceita os hosts
# `n8n`, `localhost` e `127.0.0.1`, caminho /webhook/..., sem credencial na URL.
TELEGRAM_N8N_WEBHOOK_URL=
# Chave HMAC que o backend usa para assinar o envelope e a resposta. SEGREDO: >= 32
# caracteres aleatorios, so no .env do SERVIDOR, nunca no Git, nunca no n8n.
# Gerar:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
TELEGRAM_INGEST_SIGNING_KEY=
# /contas_pagar (Plantae, so leitura, so homologacao) pelo chat. Opt-in PROPRIO:
# ligar o Plantae nao leva dado financeiro para o Telegram. Exige tambem
# PLANTAE_ENABLED=true e a permissao `plantae:read` (so ADMIN, por padrao).
PLANTAE_CHAT_COMMANDS_ENABLED=false
# Fase 6 - ATESTADO do operador: a organizacao da chave do Plantae foi conferida com uma referencia
# INDEPENDENTE (dado da cliente ou confirmacao formal do Plantae). `GET /me` devolver 200 NAO prova
# isso. Sem `true`, /contas_pagar nao consulta o Plantae e o boot recusa ligar o comando de chat com
# PLANTAE_ENABLED=true. Procedimento: docs/integracao-plantae.md (secao 10).
PLANTAE_ORGANIZATION_CONFIRMED=false
# Mostrar o nome (abreviado) do favorecido em /contas_pagar? Padrao false (o Telegram nao e ponta a ponta
# e nao ha politica autorizando divulgar favorecido por chat). A resposta sempre traz uma referencia curta.
PLANTAE_CHAT_SHOW_PAYEE_NAME=false
# Mensagens por minuto que UM remetente pode enviar ao bot (1 a 120; padrao 10). O excesso
# e descartado sem executar nada; o usuario recebe um unico aviso por janela.
# TELEGRAM_USER_RATE_LIMIT_PER_MINUTE=10
# SOMENTE TESTE: aponta a Bot API para o servidor FALSO (backend/test/fake-telegram). Aceita so
# telegram-fake, localhost e 127.0.0.1. DEIXE VAZIO em qualquer ambiente real.
TELEGRAM_API_BASE_URL=

# ---------------------------------------------------------------------------
# WhatsApp  (Cloud API OFICIAL da Meta - DESLIGADO por padrao)
# ---------------------------------------------------------------------------
# Ver docs/whatsapp.md. Ligado exige TODAS as variaveis abaixo (o boot e recusado se faltar alguma).
# Segredos so no .env do SERVIDOR: nunca no Git, no n8n ou no frontend. NAO ligar sem HTTPS publico.
WHATSAPP_ENABLED=false
# Token que VOCE inventa (>= 16 caracteres, sem espacos) e cola no painel da Meta ao configurar o webhook.
WHATSAPP_WEBHOOK_TOKEN=
# App Secret do app da Meta (Configuracoes do app > Basico). Assina cada POST do webhook.
WHATSAPP_APP_SECRET=
# Token de acesso permanente de um USUARIO DE SISTEMA, com a permissao whatsapp_business_messaging.
WHATSAPP_ACCESS_TOKEN=
# ID do numero de telefone (painel WhatsApp > Configuracao da API). Mensagens de outro numero sao ignoradas.
WHATSAPP_PHONE_NUMBER_ID=
# Versao da Graph API a usar (ex.: v21.0). Sem padrao no codigo: confira a versao vigente na Meta.
WHATSAPP_GRAPH_API_VERSION=
# SO TESTE: Graph API falsa (hosts whatsapp-fake, localhost, 127.0.0.1). VAZIO em ambiente real.
WHATSAPP_API_BASE_URL=
# Responder a quem NAO esta vinculado (e ao aviso de limite)? Padrao false = silencio com desconhecidos. Mantenha
# false, sobretudo se o numero tambem atende clientes (coexistencia): senao cada cliente recebe resposta do bot.
# O comando /vincular <codigo> sempre responde. Ver docs/whatsapp-ativacao.md.
WHATSAPP_REPLY_TO_UNLINKED=false

# ---------------------------------------------------------------------------
# NFS-e Nacional  (Emissor Publico Nacional / Sefin Nacional - DESLIGADA por padrao)
# ---------------------------------------------------------------------------
# Ver docs/nfse.md. Ligada exige a configuracao fiscal COMPLETA: nao ha padrao tributario nem de ambiente.
# So o backend le estas variaveis (nunca o n8n ou o frontend). O certificado nunca vai ao Git.
NFSE_ENABLED=false
# restrita (homologacao / producao restrita) ou producao. Sem padrao: comece SEMPRE por restrita.
NFSE_AMBIENTE=
# SO TESTE: servidor falso (hosts nfse-fake, localhost, 127.0.0.1). VAZIO em ambiente real.
NFSE_API_BASE_URL=
# Mantenha false ate validar o formato da troca de mensagens em producao restrita (docs/nfse.md secao 5).
NFSE_WIRE_CONTRACT_CONFIRMED=false
# Certificado digital A1 (ICP-Brasil) do PRESTADOR: caminho do .pfx DENTRO do conteiner (montado somente
# leitura, fora do Git) e a senha. O CNPJ do certificado tem de ser o do prestador.
NFSE_CERT_PFX_PATH=
NFSE_CERT_PFX_PASSWORD=
# Opcional: cadeia de AC (PEM) para validar o servidor da Sefin, se o repositorio padrao nao a conhecer.
NFSE_CA_BUNDLE_PATH=
# Prestador (a empresa que emite): CNPJ com 14 digitos, inscricao municipal e razao social (opcionais no leiaute).
NFSE_PRESTADOR_CNPJ=
NFSE_PRESTADOR_IM=
NFSE_PRESTADOR_NOME=
# Codigo IBGE (7 digitos) do municipio emissor.
NFSE_MUNICIPIO_EMISSOR_IBGE=
# Simples Nacional: 2 (MEI) ou 3 (ME/EPP). 1 (nao optante) exige IBS/CBS e NAO e suportado.
NFSE_OPCAO_SIMPLES=
# Somente ME/EPP: regime de apuracao 1, 2 ou 3 (vazio = nao informar).
NFSE_REGIME_APURACAO_SN=
# Regime especial de tributacao municipal: 0 (nenhum), 1 a 6 ou 9. Decisao da cliente/contador.
NFSE_REGIME_ESPECIAL_TRIBUTACAO=
# Serie da DPS (1 a 49999 = aplicativo proprio).
NFSE_DPS_SERIE=
# Valor MAXIMO por emissao (ex.: 5000.00). Limite de negocio da cliente.
NFSE_VALOR_MAXIMO=
# Validade do codigo de confirmacao, em minutos (2 a 30; padrao 10).
NFSE_CONFIRMATION_TTL_MINUTES=

# ---------------------------------------------------------------------------
# HTTPS publico (so na VPS, com docker-compose.https.yml - ver docs/deploy-vps.md)
# ---------------------------------------------------------------------------
# Dominio do VastaFlow (um unico host: app + /api + webhook do WhatsApp). `scripts/https-init.sh` recusa
# valores de exemplo e exige que o DNS ja aponte para a VPS. NAO presuma que o DNS exista.
# Subdominio gratuito DuckDNS funciona igual a um dominio proprio, ex.: SERVER_NAME=vastaflow.duckdns.org
# (o token do DuckDNS NAO fica aqui: vai em /etc/vastaflow/duckdns.env - ver infra/duckdns/duckdns.env.example).
# A URL do webhook do WhatsApp e DERIVADA: https://<SERVER_NAME>/api/webhooks/whatsapp (nao ha variavel propria;
# `bash scripts/https-verify.sh` a imprime). Ligar o WhatsApp continua sendo outra decisao (docs/whatsapp.md).
SERVER_NAME=
# E-mail para avisos de vencimento do Let's Encrypt.
LETSENCRYPT_EMAIL=
# Quando HTTPS estiver no ar: VITE_API_URL continua /api (mesma origem) e FRONTEND_ORIGIN pode ficar vazio.
