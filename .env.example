# ===========================================================================
# VastaFlow - modelo de variaveis de ambiente
# ---------------------------------------------------------------------------
# Copie este arquivo para `.env` e preencha os valores do SEU ambiente.
#
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux / macOS:         cp .env.example .env
#
# O arquivo `.env` esta no .gitignore e NUNCA deve ser versionado.
# Nao preencha valores reais neste arquivo de exemplo.
#
# O backend le `backend/.env`; o docker-compose le o `.env` da raiz. Mantenha
# os dois com os mesmos valores de banco:
#   Windows (PowerShell):  Copy-Item .env backend\.env
#   Linux / macOS:         cp .env backend/.env
# ===========================================================================

# ---------------------------------------------------------------------------
# Aplicacao
# ---------------------------------------------------------------------------
# Ambiente de execucao: development | production | test
NODE_ENV=development

# Porta HTTP do backend
PORT=3000

# Identificador do servico, devolvido por GET /health
APP_NAME=vasta-flow

# Expor a documentacao Swagger em /docs.
# Padrao `false`: a documentacao descreve toda a superficie da API, entao e
# opt-in explicito. A aplicacao RECUSA iniciar com `true` em producao.
SWAGGER_ENABLED=true

# Origens autorizadas a chamar a API pelo navegador (CORS), separadas por
# virgula. Vazio = CORS desligado. Em desenvolvimento e a URL do Vite.
FRONTEND_ORIGIN=http://localhost:5173


# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
# Define qual driver sera usado pela camada de persistencia: mysql | oracle
DATABASE_TYPE=mysql

# Sem DATABASE_URL, HOST/NAME/USER/PASSWORD sao obrigatorios.
DATABASE_HOST=127.0.0.1
# Padrao por driver quando vazio: 3306 (MySQL) | 1521 (Oracle)
DATABASE_PORT=3306
DATABASE_NAME=vastaflow
DATABASE_USER=vastaflow
# Escolha uma senha para o SEU ambiente local
DATABASE_PASSWORD=

# Exige TLS na conexao com o MySQL, verificando o certificado do servidor.
# Padrao `false`, porque o MySQL local normalmente nao tem TLS. A aplicacao
# RECUSA iniciar em producao com MySQL e este valor em `false`.
# Nao existe opcao para desligar a verificacao do certificado.
DATABASE_SSL=false

# CA que assina o certificado do servidor, em PEM (o CONTEUDO, nao um caminho).
# Vazio com DATABASE_SSL=true usa o pacote de CAs que o proprio driver mysql2
# embarca para bancos gerenciados da AWS - suficiente para RDS.
# NUNCA versione um certificado: preencha apenas no ambiente.
DATABASE_SSL_CA=

# Fluxo padrao: `false` + `npm run migration:run` (em backend/).
# `true` cria/altera as tabelas direto das entities ao subir, ignorando as
# migrations - so para prototipo local e descartavel. A aplicacao recusa iniciar
# com `true` em producao. Nao misture: um banco criado por synchronize nao
# aceita as migrations depois (as tabelas ja existiriam).
DATABASE_SYNCHRONIZE=false

# URL de conexao completa. Opcional: quando preenchida, tem precedencia
# sobre as variaveis HOST/PORT/NAME/USER/PASSWORD acima.
DATABASE_URL=

# Exclusivo Oracle - preencha APENAS UM dos dois, conforme o que o DBA expor.
# Consulte docs/adr/0001-escolha-do-orm-e-estrategia-de-banco.md
DATABASE_ORACLE_SID=
DATABASE_ORACLE_SERVICE_NAME=

# Senha do usuario root do MySQL usado pelo docker-compose (desenvolvimento local)
DATABASE_ROOT_PASSWORD=


# ---------------------------------------------------------------------------
# Autenticacao
# ---------------------------------------------------------------------------
# OBRIGATORIO. Segredo de assinatura do JWT, com no minimo 32 caracteres.
# Gere um valor aleatorio e longo por ambiente. Sugestao:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Tempo de validade do token de acesso, no formato 30s, 15m, 1h, 7d
JWT_EXPIRES_IN=1h

# Custo do hash bcrypt (4 a 15; 10 a 12 e o intervalo usual)
BCRYPT_SALT_ROUNDS=12

# Administrador inicial, criado no boot se ainda nao existir. Informe os dois
# juntos. E a UNICA forma de obter o primeiro ADMIN: o cadastro publico
# (POST /auth/register) so cria usuarios comuns. A senha precisa ter 8 a 72
# caracteres, com maiuscula, minuscula e numero. Apague-a do .env depois do
# primeiro boot, se preferir - o usuario ja fica salvo no banco.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrador


# ---------------------------------------------------------------------------
# Integracoes externas pendentes  (sem implementacao)
# ---------------------------------------------------------------------------
# As chaves abaixo sao apenas reserva de nome. Nenhuma destas integracoes foi
# implementada e nenhum endpoint foi definido: eles so serao preenchidos
# quando tivermos a documentacao e o acesso oficiais de cada provedor.
#
# WHATSAPP_*   - pendente de definicao do provedor
# PLANTAE_*    - pendente de documentacao da API
# NFSE_*       - pendente de definicao do municipio/provedor
# EMAIL_*      - pendente de definicao do servidor SMTP

# ---------------------------------------------------------------------------
# Integracao: Telegram (Bot API oficial)
# ---------------------------------------------------------------------------
# Token do bot, emitido pelo @BotFather. SEGREDO: nunca versionar o valor.
# Vazio = integracao NOT_CONFIGURED; a aplicacao sobe normalmente.
TELEGRAM_BOT_TOKEN=
# Recebe mensagens por long polling (getUpdates). Opt-in: o token sozinho nao
# liga o polling. Ligue em UM unico ambiente por bot - o Telegram recusa dois
# getUpdates simultaneos para o mesmo bot.
TELEGRAM_POLLING_ENABLED=false
